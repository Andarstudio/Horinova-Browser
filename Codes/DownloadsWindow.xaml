<Window x:Class="Horinova.DownloadsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Downloads" Width="720" Height="480" WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/horinova.ico">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
      <Button Content="Open file" Padding="8,2" Click="Open_Click"/>
      <Button Content="Show in folder" Margin="6,0,0,0" Padding="8,2" Click="Folder_Click"/>
      <Button Content="Cancel" Margin="6,0,0,0" Padding="8,2" Click="Cancel_Click"/>
      <Button Content="Clear finished" Margin="6,0,0,0" Padding="8,2" Click="Clear_Click"/>
    </StackPanel>
    <ListView x:Name="List">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="File" Width="260" DisplayMemberBinding="{Binding FileName}"/>
          <GridViewColumn Header="Progress" Width="200">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <ProgressBar Minimum="0" Maximum="100" Height="14" Value="{Binding Percent, Mode=OneWay}"/>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="Status" Width="200" DisplayMemberBinding="{Binding Status}"/>
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
