<Window Icon="pack://application:,,,/Assets/horinova.ico"
        x:Class="Horinova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Horinova" Width="1200" Height="780">
  <DockPanel>
    <Grid DockPanel.Dock="Top" Margin="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="←" Width="32" Margin="2" Click="Back_Click"/>
      <Button Grid.Column="1" Content="→" Width="32" Margin="2" Click="Forward_Click"/>
      <Button Grid.Column="2" Content="⟳" Width="32" Margin="2" Click="Reload_Click"/>
      <Button Grid.Column="3" Content="+" Width="32" Margin="2" Click="NewTab_Click" ToolTip="New tab"/>
      <Button Grid.Column="4" Content="🕶" Width="32" Margin="2" Click="PrivateTab_Click" ToolTip="New private tab"/>
      <TextBox Grid.Column="5" x:Name="AddressBox" Margin="4,2" Padding="6,4" KeyDown="Address_KeyDown"/>
      <TextBlock Grid.Column="6" x:Name="ShieldText" Text="🛡 0" VerticalAlignment="Center" Margin="8,0" ToolTip="Ads and trackers blocked"/>
      <Button Grid.Column="7" Content="🕘" Width="32" Margin="2" Click="History_Click" ToolTip="History"/>
      <Button Grid.Column="8" Content="⬇" Width="32" Margin="2" Click="Downloads_Click" ToolTip="Downloads"/>
      <Button Grid.Column="9" Content="⚙" Width="32" Margin="2" Click="Settings_Click" ToolTip="Settings"/>
    </Grid>
    <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged"/>
  </DockPanel>
</Window>
